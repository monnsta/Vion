set -u

# --- 1. Configuration ---
PYTHON_BIN=".venv/bin/python"
PIP_BIN=".venv/bin/pip"
BOT_FILE="bot.py"
REQUIREMENTS="requirements.txt"

RESTART_WAIT=2
MAX_CRASHES=2
CRASH_WINDOW=60

# Default behavior flags
SUPERVISE=false
INSTALL_DEPS=false
CHECK_ENV=false

# --- 2. Internal Setup ---
APP_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
BOT_PATH="$APP_DIR/$BOT_FILE"
REQ_PATH="$APP_DIR/$REQUIREMENTS"
CRASH_TS=()

DIM='\033[2m'
BOLD='\033[1m'
RED='\033[1;31m'
GRN='\033[1;32m'
YLW='\033[1;33m'
CYN='\033[1;36m'
MAG='\033[1;35m'
RES='\033[0m'

# --- 3. Functions ---
get_ts() {
	echo -e "${DIM}$(date '+%H:%M:%S')${RES}"
}

log() {
	echo -e "$(get_ts) ${GRN}I${RES} $1"
}

warn() {
	echo -e "$(get_ts) ${YLW}W${RES} $1"
}

error() {
	echo -e "$(get_ts) ${RED}E${RES} $1" >&2
}

prompt_confirm() {
	echo -en "$(get_ts) ${YLW}?${RES} $1 [y/N]: "
	read -r response
	if [[ "$response" =~ ^[Yy]$ ]]; then
		return 0
	fi
	return 1
}

show_help() {
	local cols=$(tput cols 2>/dev/null || echo 80)
	local sep=$(printf "%${cols}s" "")

	echo -e "${MAG}${BOLD}▶ BOT EXECUTOR MANAGER${RES}"
	echo -e "${DIM}${sep// /-}${RES}"
	echo -e "${BOLD}Usage:${RES} $0 [OPTIONS]\n"
	echo -e "${BOLD}Options:${RES}"

	print_opt() {
		local flags="$1"
		local desc="$2"
		local color="${3:-}"
		local pad_len=22
		local desc_len=$((cols - pad_len))
		[[ $desc_len -lt 20 ]] && desc_len=20

		printf "${color}  %-19s ${RES}" "$flags"
		echo "$desc" | fold -s -w "$desc_len" | awk -v pad="$pad_len" 'NR==1{print $0} NR>1{printf "%*s%s\n", pad, "", $0}'
		echo ""
	}

	print_opt "-s, --supervise" "Enable auto-restart and crash monitoring loop" "${CYN}"
	print_opt "-i, --install" "Check and install dependencies before running" "${CYN}"
	print_opt "-c, --check" "Verify environment (Python, Pip, Script existence)" "${CYN}"
	print_opt "-r, --restart N" "Set restart wait time in seconds (default: 2)" "${CYN}"
	print_opt "-m, --max-crashes N" "Set max crashes allowed in window (default: 2)" "${CYN}"
	print_opt "-h, --help" "Show this help message" "${CYN}"
}

check_env() {
	log "Checking environment..."
	if [[ ! -x "$APP_DIR/$PYTHON_BIN" ]]; then
		error "Python executable not found or not executable: $APP_DIR/$PYTHON_BIN"
		exit 1
	fi

	if [[ "$INSTALL_DEPS" == true ]] && [[ ! -x "$APP_DIR/$PIP_BIN" ]]; then
		error "Pip executable not found or not executable: $APP_DIR/$PIP_BIN"
		exit 1
	fi

	if [[ ! -f "$BOT_PATH" ]]; then
		error "Bot script not found: $BOT_PATH"
		exit 1
	fi
	log "Environment OK."
}

verify_termux_crypto() {
	if [[ -n "${PREFIX:-}" && "$PREFIX" == *"/com.termux/"* ]]; then
		# Check if cryptography is installed via pip but the Rust bindings fail
		if "$APP_DIR/$PIP_BIN" freeze 2>/dev/null | grep -qi "^cryptography==" && \
		   ! "$APP_DIR/$PYTHON_BIN" -c "from cryptography.hazmat.bindings import _rust" 2>/dev/null; then

			warn "Broken Termux cryptography binary detected. Injecting system package..."

			log "Uninstalling broken pip version..."
			"$APP_DIR/$PIP_BIN" uninstall -y cryptography >/dev/null 2>&1

			log "Installing pre-compiled Termux package via pkg..."
			pkg install -y python-cryptography || warn "Failed to install python-cryptography via pkg."

			log "Injecting system cryptography into venv..."
			local PY_VER
			PY_VER=$("$APP_DIR/$PYTHON_BIN" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')

			local SYS_SITE_PACKAGES="$PREFIX/lib/python$PY_VER/site-packages"
			local VENV_SITE_PACKAGES="$APP_DIR/.venv/lib/python$PY_VER/site-packages"

			if [[ -d "$SYS_SITE_PACKAGES/cryptography" ]]; then
				cp -r "$SYS_SITE_PACKAGES/cryptography" "$VENV_SITE_PACKAGES/"
				cp -r "$SYS_SITE_PACKAGES"/cryptography-*.dist-info "$VENV_SITE_PACKAGES/" 2>/dev/null || true
				log "Cryptography successfully injected and fixed!"
			else
				error "Could not locate system cryptography at $SYS_SITE_PACKAGES"
			fi
		fi
	fi
}

install_deps() {
	if [[ -f "$REQ_PATH" ]]; then
		log "Checking/Installing dependencies..."

		if [[ -n "${PREFIX:-}" && "$PREFIX" == *"/com.termux/"* ]]; then
			if ! command -v cargo &> /dev/null || ! command -v clang &> /dev/null; then
				warn "Missing build tools (rust, clang)."
				if prompt_confirm "Do you want to install Termux build tools using pkg?"; then
					pkg install -y rust clang binutils make libffi openssl || warn "Failed to install Termux build tools."
				else
					warn "Skipping tool installation. Pip compilation might fail."
				fi
			fi
		fi

		if ! "$APP_DIR/$PIP_BIN" install -r "$REQ_PATH"; then
			error "Dependency installation failed."
			if [[ -n "${PREFIX:-}" && "$PREFIX" == *"/com.termux/"* ]]; then
				warn "Attempting Termux mathlib fallback..."
				if ! MATHLIB=m "$APP_DIR/$PIP_BIN" install -r "$REQ_PATH"; then
					warn "Fallback failed. Attempting to run anyway."
				fi
			else
				warn "Attempting to run anyway."
			fi
		fi
	else
		warn "No $REQUIREMENTS found."
	fi
}

is_crash_looping() {
	local now=$(date +%s)
	local cutoff=$((now - CRASH_WINDOW))

	local updated_ts=()
	for ts in "${CRASH_TS[@]}"; do
		if [[ "$ts" -gt "$cutoff" ]]; then
			updated_ts+=("$ts")
		fi
	done

	updated_ts+=("$now")
	CRASH_TS=("${updated_ts[@]}")

	if [[ ${#CRASH_TS[@]} -gt $MAX_CRASHES ]]; then
		return 0
	fi
	return 1
}

# --- 4. Parse Arguments ---
while [[ $# -gt 0 ]]; do
	case "$1" in
		-[!-]?*)
			opts="${1#-}"
			shift
			set -- $(echo "$opts" | sed 's/./-& /g') "$@"
			continue
			;;
		-s|--supervise)
			SUPERVISE=true
			shift
			;;
		-i|--install)
			INSTALL_DEPS=true
			shift
			;;
		-c|--check)
			CHECK_ENV=true
			shift
			;;
		-r|--restart)
			if [[ -z "${2:-}" || ! "$2" =~ ^[0-9]+$ ]]; then
				error "Option $1 requires a valid numerical argument."
				exit 1
			fi
			RESTART_WAIT="$2"
			shift 2
			;;
		-m|--max-crashes)
			if [[ -z "${2:-}" || ! "$2" =~ ^[0-9]+$ ]]; then
				error "Option $1 requires a valid numerical argument."
				exit 1
			fi
			MAX_CRASHES="$2"
			shift 2
			;;
		-h|--help)
			show_help
			exit 0
			;;
		*)
			error "Unknown option: $1"
			show_help
			exit 1
			;;
	esac
done

# --- 5. Main Execution ---
clear

trap "log 'Manual interruption detected. Exiting...'; exit 0" SIGINT SIGTERM

[[ "$INSTALL_DEPS" == true ]] && CHECK_ENV=true

[[ "$CHECK_ENV" == true ]] && check_env
[[ "$INSTALL_DEPS" == true ]] && install_deps

verify_termux_crypto

if [[ "$SUPERVISE" == false ]]; then
	log "Starting bot..."
	"$APP_DIR/$PYTHON_BIN" "$BOT_PATH"
	exit $?
fi

while true; do
	log "Supervisor active. Monitoring $BOT_FILE..."
	log "Starting bot..."
	"$APP_DIR/$PYTHON_BIN" "$BOT_PATH"
	EXIT_CODE=$?

	case $EXIT_CODE in
		0)
			log "Clean exit detected. Stopping."
			break
			;;
		10)
			log "Critical error. Exiting."
			break
			;;
		42)
			log "System requested immediate restart..."
			sleep 1
			;;
		130 | 143)
			log "Termination signal ($EXIT_CODE). Exiting."
			break
			;;
		*)
			error "Bot crashed with code $EXIT_CODE."

			if is_crash_looping; then
				error "FATAL: Reached $MAX_CRASHES crashes in ${CRASH_WINDOW}s. Manual intervention required."
				exit 1
			fi

			log "Restarting in ${RESTART_WAIT}s (Failure ${#CRASH_TS[@]}/$MAX_CRASHES)..."
			sleep "$RESTART_WAIT"
			;;
	esac
done
